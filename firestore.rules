// Spillerportal-regler. FLETTES inn i gjeldende produksjonsregler.
rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function isCoach(){return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coach";}
 function playerAccount(){return get(/databases/$(database)/documents/playerAccounts/$(request.auth.uid));}
 function approvedPlayer(){return request.auth != null && playerAccount().data.approved == true && playerAccount().data.playerId != null;}
 match /playerAccounts/{uid} {
  allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.approved == false && request.resource.data.playerId == null;
  allow read: if request.auth != null && (request.auth.uid == uid || isCoach());
  allow update: if isCoach(); allow delete: if false;
 }
 match /developmentRequests/{id} {
  allow create: if approvedPlayer() && request.resource.data.uid == request.auth.uid && request.resource.data.playerId == playerAccount().data.playerId && request.resource.data.status == "open";
  allow read: if isCoach() || (approvedPlayer() && resource.data.uid == request.auth.uid && resource.data.playerId == playerAccount().data.playerId);
  allow update: if isCoach(); allow delete: if false;
 }
 match /developmentMessages/{id} {
  allow read: if isCoach() || (approvedPlayer() && resource.data.playerId == playerAccount().data.playerId);
  allow create: if isCoach() || (approvedPlayer() && request.resource.data.playerId == playerAccount().data.playerId && request.resource.data.uid == request.auth.uid && request.resource.data.senderRole == "player");
  allow update: if false;
  allow delete: if isCoach() || (approvedPlayer() && resource.data.uid == request.auth.uid && resource.data.playerId == playerAccount().data.playerId);
 }
}}